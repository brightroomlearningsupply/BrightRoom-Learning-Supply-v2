<div class = "page">

    <section class = "section">
        <div class="nav" >
            
            <%= image_tag "logo.svg", class: "footer-logo" %>
            <h3 style = "font-family: 'Lilia One',sans-serif;
                font-weight: 800; align-self:center; margin-left: 20px;">
                BrightRoom <br>
                Learning Supplies
            </h3>
            
        </div>
        <%= render "hero_section" %>
    </section>

    <section class = "section" style = "background: #F2D04E;">
        <%= render "process_section" %>
    </section>

    <section class = "section" style = "background: #E9BE5F;">
        <%= render "about_section" %>
    </section>

    <footer>
        <%= link_to root_path, class: "footer-logo-link" do %>
  <div class="footer-top">
    <%= image_tag "logo.svg", class: "footer-logo", alt: "BrightRoom Learning Supplies" %>
    <h3>BrightRoom <br>Learning Supplies</h3>
  </div>
<% end %>

        <div class = "footer-middle">
            <div class="dropoff-locations">
                <%= image_tag "location.svg", class: "location-icon" %>

                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <h3>MAIL DONATIONS TO</h3>
                    <p>6025 Stage Road Ste 42 PMB 153, Bartlett, TN 38134</p>
                </div>

                <%= link_to @location, target: "_blank", rel: "noopener noreferrer", class: "map_link" do %>
                    <%= image_tag "brightroom-map.webp",
                                class: "map-image",
                                alt: "View mailing address on Google Maps" %>
                <% end %>
            </div>

            <div class = "contact">
                <%= image_tag "email.svg", class: "contact-icon" %>
                <div style="display:flex; flex-direction: column;gap:10px;">
                    <h3> QUESTIONS? </h3>
                    <p> Email any time at:</p>
                    <p style="font-weight: 200;"> <%= mail_to "brightroomlearningsupply@gmail.com", "brightroomlearningsupply@gmail.com", class: "email-link" %> </p>
                    <p>or call:</p>
                    <p><%= phone_to "(901) 330-0169" , class: "email-link"%></p>
                </div>
            </div>
                
        </div>

        <div class = "footer-bottom">
                <p> @2026 BrightRoom Learning Supply. All rights reserved. </p>
        </div>
    </footer>
</div>

<style>
.page{
    width: 100vw;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
    overflow-x:hidden;
}

.section{
    width: 100%;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    font-family: 'Kanchenjunga',sans-serif;
}
.section-content{
    
    max-width: 1780px;
    min-height: 1000px;
    padding: 40px 0;
}


.program-section{
    width: 90%;
    background: #F2D04E;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
}
.about-section{
    width: 90%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
}

.get-invovled-section{
    width: 100%;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
}
/******************************************/

footer{
    color: white;
    gap: 20px;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40px 40px 20px 40px;
}


.footer-top{
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
}

.footer-logo{
    width: 100px;
    height: auto;
}

.footer-top h3{
    font-family: 'Lilia One',sans-serif;
    font-weight: 800;
    font-size: 24px;
    margin-left: 20px;
}

.footer-logo-link {
    width: 100%;
  color: inherit;
  text-decoration: none;
  display: inline-block;
}

.footer-logo-link .footer-top {
  cursor: pointer;
}

/******************************************/
.footer-middle{
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    
    min-height:200px;

    padding: 20px;
}

.footer-middle h3{
    font-weight: 800;
    font-size: 24px;
}

.contact, .dropoff-locations{
    flex:1;
    height: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 20px;
    font-family: 'Lilita One',sans-serif;
}
.dropoff-locations{
    border-right: 2px solid #F2D04E;
}

.footer-middle p{
    
    font-weight: 600;
    font-size: 18px;
}

.map-image {
  height: 100%;
  width: 200px;
  object-fit: cover;
  border-radius: 24px;
  cursor: pointer;

  transition:
    transform 0.3s ease-in-out,
    box-shadow 0.3s ease-in-out,
    filter 0.3s ease-in-out;
}

.map-image:hover {
  transform: scale(1.05);
  box-shadow:
    0 0 0 2px rgba(255, 255, 255, 0.5),
    0 6px 14px rgba(0, 0, 0, 0.15);
  filter: brightness(1.04);
}

.email-link {
  color: inherit;
  text-decoration: none;
}

.email-link:hover {
  text-decoration: underline;
}

.footer-bottom{
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-bottom: 40px;
    padding-top: 20px;
    font-family: "Kanchenjunga", sans-serif;
}

@media (max-width: 900px) {
    footer{
        gap: 40px;
        padding: 20px 20px 10px 20px;
    }
    .footer-middle{
        flex-direction: column;
    }

    .footer-top{
        flex-direction: column;
        text-align: center;
        
    }

    .contact, .dropoff-locations{
        flex-direction: column;
        gap: 10px;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 10px;
    }

    .footer-bottom{

        font-size: 20px;
    }

    .dropoff-locations{
    border-right: none;
    border-bottom: 2px solid #F2D04E;
    padding-bottom: 20px;
}

.map-image{
    width: 100%;
    height: 80px;
    border-radius: 12px;
}

.map_link{
    width: 100%;
}

.email-link{
    text-decoration: underline;
}

}




.nav{
    display: flex; margin: 20px; max-width: 1780px; width:100%; justify-content: left; 
}
@media(max-width: 1366px) {
    .nav{
        width: 90%;
    }}
</style>