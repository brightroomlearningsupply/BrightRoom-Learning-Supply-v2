<div class = "section-content program-section">
            <div class = "title program-title">
                <h1> 
                    <span class = "title-text-top">Opening Doors.</span>
                    <span class = "title-text-bottom">Empowering Minds.</span>
                </h1>
            </div>
            <div class = "program-stack">
                    <div class = "program-stack-item first-step">
                        <div class = "program-stack-item-image">
                            <%= image_tag 'backpack-svgrepo-com.svg', alt: 'Free School Supplies', class: 'program-stack-item-image-icon' %>
                            <h3>Free School Supplies</h3>
                        </div>
                        <div class = "program-stack-item-content">
                            <h3>Free School Supplies</h3>
                            <p>Provide essential items teacher and students need to succeed.</p>
                        </div>
                    </div>
                
                    <div class = "program-stack-item second-step">
                        <div class = "program-stack-item-image">
                            <%= image_tag 'book-svgrepo-com.svg', alt: 'Empower Educators', class: 'program-stack-item-image-icon' %>
                            <h3>Empower Educators</h3>
                        </div>
                        <div class = "program-stack-item-content">
                            <h3>Empower Educators</h3>
                            <p>Support teachers with the tools and resources they deserve.</p>
                        </div>
                    </div>
            
                    <div class = "program-stack-item third-step">
                        <div class = "program-stack-item-image">
                                <%= image_tag 'community.svg', alt: 'Community', class: 'program-stack-item-image-icon' %>
                                <h3>Strengthen Communities</h3>
                            
                        </div>
                        <div class = "program-stack-item-content">
                            <h3>Strengthen Communities</h3>
                            <p>Invest in their education, inspire their potential, and build brighter futures.</p>
                        </div>
                    </div>
                    

                    <div class = "program-stack-item forth-step">
                        <div class = "program-stack-item-image">
                            <%= image_tag 'difference.svg', alt: 'Make a Difference', class: 'program-stack-item-image-icon' %>
                            <h3>Make a Difference </h3>
                        </div>
                        <div class = "program-stack-item-content">
                            <h3>Make a Difference </h3>
                            <p>Your donation has a lasting impact year-round.</p>
                        </div>
                    </div>
                    
            </div>
                <%= button_to "Donate Now",
                @donation,
                method: :get,
                class: "button hero-button",
                form: { target: "_blank" } %>
            </div>





<style>



.program-title{
    margin-bottom: 60px;
}
.program-title h1{
    font-family: 'Lilita One',sans-serif;
    font-weight: 800;
    font-size: 80px;
    text-align: center;
    display: flex;
    flex-direction: column;
}
.program-title h1 .title-text-top{
    text-align: left;
    color:white;
}
.program-title h1 .title-text-bottom{
    margin-top: -20px;
    text-align: right;
    margin-left: 200px;
    color: #184981
}


.program-stack-item-image{
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100px;
    height: 100%;
}

.program-stack-item-image h3{
    display: none;
}
.program-stack-item-image-icon{ 
    width: 100px;
    height: 100px;
    border-radius: 12px;
}


.program-stack-item-content{
    display: flex;
    flex-direction: column;
    justify-content: top;
    align-items: flex-start;
    width: auto;
    gap: 12px;

}

.program-stack-item-content h3{
    font-family: 'Lilita One',sans-serif;
    font-size: 36px;
    font-weight: 800;
}
.program-stack-item p{
    font-size: 28px;
    font-weight: 600;
}

.first-step{
    border-radius: 36px 100px 0px;
}

.second-step{
    border-radius: 100px 36px 100px 0px;
}

.third-step{
    border-radius: 100px 0px 100px 36px;
}

.forth-step{
    border-radius: 0px 100px 36px 100px;
}




/***********************************************/

.program-stack {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    color: #24221B;
    margin-bottom: 40px;
}

.program-stack-item {
    width: 100%;
    min-width: 0;
    min-height: 260px;
    height: auto;
    padding: clamp(24px, 3vw, 40px);
    box-sizing: border-box;
    background: #FFF8E7;
    display: flex;
    flex-direction: row;
    gap: 20px;
}

.program-stack-item-content {
    min-width: 0;
}

/* Shrink the cards and their content first */
@media (max-width: 1200px) {
    .program-stack-item-content h3 {
        font-size: 30px;
    }

    .program-stack-item p {
        font-size: 22px;
    }

    .program-stack-item-image,
    .program-stack-item-image-icon {
        width: 80px;
    }

    .program-stack-item-image-icon {
        height: 80px;
    }
}

/* Then place one card per line */
@media (max-width: 900px) {
    .program-stack {
        grid-template-columns: 1fr;
    }

    .program-stack-item {
        max-width: 706px;
        margin-inline: auto;
    }
}

@media (max-width: 600px) {
    .title-text-top,
    .title-text-bottom {
        font-size: 44px;
    }

    .program-stack-item {
        width: 100%;
        padding: 30px 30px;
        flex-direction: column;
    }

    .program-stack-item-image h3 {
        display: block;
        font-size: 28px;
    }

    .program-stack-item-image {
        width: 100%;
        height: auto;
        gap: 20px;
    }

    .program-stack-item-content {
        width: 100%;
    }

    .program-stack-item-content h3 {
        display: none;
    }

    .program-title h1 .title-text-bottom {
        margin-left: 0;
        margin-top: -10px;
        text-align: left;
    }

    .first-step{
    border-radius:  36px 60px 0px 60px;
    }

    .second-step{
        border-radius: 60px 36px 60px 0px;
    }

    .third-step{
        border-radius: 60px 0px 60px 36px;
    }

    .forth-step{
        border-radius: 0px 60px 36px 60px;
    }


}

</style>