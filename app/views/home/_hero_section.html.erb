<div class = "section-content hero-banner">
            <div class = "left-hand-side">
                <div class = "title hero"> Be the <span style="color: #F2D04E;">light</span> in someone’s classroom today </div>

                <div class = "hero-text">BrightRoom Learning Supply provides school supplies, books, and resources to students and teachers in need. Providing support and brightening futures one classroom at a time. </div>
            
                <%= button_to "Donate Now",
      @donation,
      method: :get,
      class: "button hero-button",
      form: { target: "_blank" } %>
            </div>

            <div class = "right-hand-side">
                <%= image_tag "heroImageOne.png", class: "hero-image image-one" %>
                <div class = "group">
                    <%= image_tag "heroImageTwo.png", class: "hero-image image-two" %>
                   <%= image_tag "heroImageThree.png", class: "hero-image image-three" %>
                </div>
            </div>
        </div>


<style>

.group{
    display:flex;
    flex-direction: row;
    gap: 40px;

}
.left-hand-side{
    flex: 1;
    padding: 20px;

    display: flex;
    flex-direction: column;

}
 
.right-hand-side{
    flex: 1;
    padding: 40px;
    display: flex;
    justify-content: flex-start;
    
    flex-direction: column;
    gap: 40px;
}

.title{
    font-family: 'Lilita One',sans-serif;
    font-weight: 800;
    font-size: clamp(48px, 5vw, 60px);
    text-align: left;
    margin-bottom: 100px;
}

.hero-text{
    font-weight: 400;
    font-size: 26px;
    text-align: left;
    margin-bottom: 20px;
}

button{
width: 230px;
height: 57px;

background: linear-gradient(180deg, #F5E8B6 0%, #E2CF88 100%);
box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
border-radius: 12px 36px;
border: none;   
text-align: center;
 font-size: 26px;
font-weight: 600;
transition: all 0.3s ease-in-out;
}

button:hover{
    border-radius: 12px 12px;
    background: linear-gradient(180deg, #E2CF88 0%, #F5E8B6 100%);
}

.hero-image{
    width: 338px;
    height: 262px;
    background: blue;
    border-radius: 24px;
    object-fit: cover;
}

.image-one{
    background: purple;
    align-self:center;
}

.image-two{
    width: 374px;
    height: 326px;
    margin-top: 30px;
    margin-left: 0;
}

.image-three {
    width: 262px;
    height: 315px;
    
    background: red;
}


.hero-banner{
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 20px;
    width: 100%;
    height: 80vh;
}


@media(max-width: 1366px) {
    .hero-banner{
        flex-direction: column;
        height: auto;
        width:90%;
        
    }
    .hero{
        margin-bottom: 40px;
    }

    .left-hand-side{

    }
    .right-hand-side{
        width: 100%;
        display: flex;
        justify-content: center;
        flex-direction: column;
    }

    .image-one{
    }

    .group{
        justify-content: center;
    }
     .image-two{
        
    width: 374px;
    height: 326px;
    }
     .image-three{
            
    }
}

@media(max-width: 800px){
    .left-hand-side{
        padding: 0;
    }

    .right-hand-side{
        gap: 0;
        padding: 0;
        justify-content: flex-start;
    }
    .group{
        align-items: flex-end;
        justify-content: flex-end;
    }
    .image-one{
        margin-left: 0;
    
    }

    .image-three{
        display:none;
    }
    .image-two{
        align-self: right;
        width: 80%;    
        margin-top: 10px;
        margin-left: 20px;
    }

    
}
</style>
