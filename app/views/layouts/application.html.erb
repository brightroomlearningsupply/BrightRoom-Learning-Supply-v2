<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "BrightRoomLearningSupply" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
  <meta
    name="description"
    content="<%= content_for(:meta_description) || 'Bright Room Learning Supply is a Memphis, Tennessee learning supply store offering educational resources, classroom materials, and supplies for teachers, parents, and students.' %>"
  >

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Bright Room Learning Supply">

  <meta
    property="og:title"
    content="<%= content_for(:title) || 'Bright Room Learning Supply | Memphis, TN' %>"
  >

  <meta
    property="og:description"
    content="<%= content_for(:meta_description) || 'Educational resources, classroom materials, and learning supplies for teachers, parents, and students in Memphis, Tennessee.' %>"
  >

  <meta property="og:url" content="<%= request.original_url %>">

  <meta
    property="og:image"
    content="<%= image_url('pre-view.jpg') %>"
  >
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
   
   <%= favicon_link_tag "BrightRoomDarkModeLogo.svg", type: "image/svg+xml" %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
